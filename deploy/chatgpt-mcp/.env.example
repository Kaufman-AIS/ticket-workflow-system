# Copy to .env on the VPS — never commit the filled-in file.
# Generate OWNER_TOKEN with: openssl rand -hex 32

PUBLIC_BASE_URL=https://paca.kaufman-ais.com

# Paca API (same key you use for Cursor MCP)
PACA_API_URL=https://paca.kaufman-ais.com
PACA_API_KEY=

# Typed once on the ChatGPT OAuth consent screen (treat like a root password)
OWNER_TOKEN=
CHATGPT_ACTION_TOKEN=

# Optional overrides
# ACCESS_TOKEN_TTL_SECONDS=3600
# REFRESH_TOKEN_TTL_SECONDS=2592000
